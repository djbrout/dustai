# S_P23 low-z peculiar velocity survey simulation
# For fsigma8 analysis: z = 0.01 to 0.12
# Large sample for biascor + data

GENVERSION: DUSTAI_SP23_LOWZ
GENSOURCE:  RANDOM
GENMODEL:   SALT3.K21

SIMLIB_FILE: $SNDATA_ROOT/simlib/LSST/LSST_DC2_Run2.2i_WFD.SIMLIB
KCOR_FILE:   $SNDATA_ROOT/kcor/LSST/baseline/kcor_LSST.fits.gz
GENFILTERS:  griz
SOLID_ANGLE: 0.5

RANSEED: 54321
OPT_ZSPEC: 1

GENTYPE:   1
SNTYPE:    1  1
GENRANGE_REDSHIFT: 0.01  0.12
DNDZ: POWERLAW  2.6E-5  2.0
GENRANGE_PEAKMJD: 60000 61825
GENRANGE_TREST:   -40  100

# x1 population (P21 Table 4)
GENRANGE_SALT2x1:   -5.0   5.0
GENPEAK_SALT2x1:     0.0
GENSIGMA_SALT2x1:    1.0   1.0

# Intrinsic color (P23)
GENRANGE_SALT2c:    -0.3   0.5
GENPEAK_SALT2c:     -0.07
GENSIGMA_SALT2c:     0.05  0.05

GENMEAN_SALT2ALPHA: 0.15

# BS21 model: beta varies per-SN
GENMEAN_SALT2BETA:  2.07
GENSIGMA_SALT2BETA: 0.22  0.22

# Dust model (BS21/P23)
GENPEAK_RV:     1.66
GENSIGMA_RV:    0.95  0.95
GENRANGE_RV:    0.5   6.0
GENRANGE_AV:    0.0   3.0
GENTAU_AV:      0.11

OPT_MWEBV:      1
OPT_MWCOLORLAW: 99
RV_MWCOLORLAW:  3.1

SMEARFLAG_FLUX:    1
SMEARFLAG_ZEROPT:  1

GENSIGMA_VPEC: 300
VPEC_ERR:      300

OMEGA_MATTER: 0.3089
OMEGA_LAMBDA: 0.6911
W0_LAMBDA:   -1.00
H0:           67.74

NGENTOT_LC: 200000

APPLY_CUTWIN_OPT: 1
CUTWIN_SNRMAX:   5 griz 1 -20. 80.
CUTWIN_NEPOCH:   3 -5.
CUTWIN_TRESTMIN:  -15  +10
CUTWIN_TRESTMAX:   +5  +45
CUTWIN_MWEBV:      0   0.25

FORMAT_MASK:  48
PATH_SNDATA_SIM: /Volumes/External24TB/dustai/snana_sims/output_lowz

SIMGEN_DUMP: 11
  CID GENTYPE GENZ PEAKMJD SALT2x1 SALT2c SIM_mB SNRMAX AV RV MU

CIDOFF: 0

# S_COH: Coherent (achromatic) Gaussian scatter, sigma_M = 0.12
# For reproducing Figure 6 of Carreres+2025

GENVERSION: DUSTAI_SCOH
GENSOURCE:  RANDOM
GENMODEL:   SALT3.K21

SIMLIB_FILE: $SNDATA_ROOT/simlib/LSST/LSST_DC2_Run2.2i_WFD.SIMLIB
KCOR_FILE:   $SNDATA_ROOT/kcor/LSST/baseline/kcor_LSST.fits.gz
GENFILTERS:  griz
SOLID_ANGLE: 0.001

RANSEED: 12345
OPT_ZSPEC: 1

GENTYPE:   1
SNTYPE:    1  1
GENRANGE_REDSHIFT: 0.01  0.20
DNDZ: POWERLAW  2.6E-5  2.0
GENRANGE_PEAKMJD: 60000 61825
GENRANGE_TREST:   -40  100

# x1 population (P21 Table 4 approximation)
GENRANGE_SALT2x1:   -5.0   5.0
GENPEAK_SALT2x1:     0.0
GENSIGMA_SALT2x1:    1.0   1.0

# c population (P21 Table 8 approximation)
GENRANGE_SALT2c:    -0.3   0.5
GENPEAK_SALT2c:     -0.04
GENSIGMA_SALT2c:     0.04  0.08

GENMEAN_SALT2ALPHA: 0.15
GENMEAN_SALT2BETA:  3.1

# Coherent scatter only (achromatic)
GENSIGMA_SALT2ALPHA: 0.0
GENSIGMA_SALT2BETA:  0.0
GENMODEL_ERRSCALE:   0.0
GENMAG_SMEAR_MODELNAME: NONE
GENMAG_SMEAR: 0.12

# Mass step
HOSTLIB_MSKOPT: 258
GENMAG_SMEAR_ADDPHASECOR: 0.0 0.0

OPT_MWEBV:      1
OPT_MWCOLORLAW: 99
RV_MWCOLORLAW:  3.1

SMEARFLAG_FLUX:    1
SMEARFLAG_ZEROPT:  1

GENSIGMA_VPEC: 250
VPEC_ERR:      250

OMEGA_MATTER: 0.3089
OMEGA_LAMBDA: 0.6911
W0_LAMBDA:   -1.00
H0:           67.74

NGENTOT_LC: 100000

APPLY_CUTWIN_OPT: 1
CUTWIN_SNRMAX:   5 griz 1 -20. 80.
CUTWIN_NEPOCH:   3 -5.
CUTWIN_TRESTMIN:  -15  +10
CUTWIN_TRESTMAX:   +5  +45
CUTWIN_MWEBV:      0   0.25

FORMAT_MASK:  48
PATH_SNDATA_SIM: /Volumes/External24TB/dustai/snana_sims/output

SIMGEN_DUMP: 11
  CID GENTYPE GENZ PEAKMJD SALT2x1 SALT2c SIM_mB SNRMAX AV RV MU

CIDOFF: 0

&SNLCINP
  ! SALT3 fit for low-z P23 PV simulation
  VERSION_PHOTOMETRY = 'DUSTAI_SP23_LOWZ'
  PRIVATE_DATA_PATH  = '/Volumes/External24TB/dustai/snana_sims/output_lowz'

  KCOR_FILE = '$SNDATA_ROOT/kcor/LSST/baseline/kcor_LSST.fits.gz'

  SNTABLE_LIST = 'FITRES'
  TEXTFILE_PREFIX = 'FIT_DUSTAI_LOWZ'

  OPT_MWEBV = 1

  CUTWIN_SNRMAX = 5.0, 999.
  CUTWIN_NFILT_SNRMAX = 2, 99
  NFIT_ITERATION = 3
  ABORT_ON_NOEPOCHS = F
&END

&FITINP
  FITMODEL_NAME = 'SALT3.K21'
  FILTLIST_FIT = 'griz'

  FITWIN_TREST = -15.0, 45.0
  FITWIN_PROB  =  0.01, 1.01

  PRIOR_SHAPE_RANGE = -5.0, 5.0
  PRIOR_MJDSIG = 10.0
&END

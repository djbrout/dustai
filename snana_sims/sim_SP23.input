# S_P23: BS21 dust model with P23 parameters
# The most realistic scatter model — produces non-Gaussian residuals
# For reproducing Figure 6 of Carreres+2025

GENVERSION: DUSTAI_SP23
GENSOURCE:  RANDOM
GENMODEL:   SALT3.K21

SIMLIB_FILE: $SNDATA_ROOT/simlib/LSST/LSST_DC2_Run2.2i_WFD.SIMLIB
KCOR_FILE:   $SNDATA_ROOT/kcor/LSST/baseline/kcor_LSST.fits.gz
GENFILTERS:  griz
SOLID_ANGLE: 0.001

RANSEED: 12345
OPT_ZSPEC: 1

GENTYPE:   1
SNTYPE:    1  1
GENRANGE_REDSHIFT: 0.01  0.20
DNDZ: POWERLAW  2.6E-5  2.0
GENRANGE_PEAKMJD: 60000 61825
GENRANGE_TREST:   -40  100

# x1 population (P21 Table 4)
GENRANGE_SALT2x1:   -5.0   5.0
GENPEAK_SALT2x1:     0.0
GENSIGMA_SALT2x1:    1.0   1.0

# Intrinsic color (NOT total color — P23 model adds dust on top)
GENRANGE_SALT2c:    -0.3   0.5
GENPEAK_SALT2c:     -0.07
GENSIGMA_SALT2c:     0.05  0.05

GENMEAN_SALT2ALPHA: 0.15

# BS21 model: beta varies per-SN
# Intrinsic beta ~ N(2.07, 0.22)
GENMEAN_SALT2BETA:  2.07
GENSIGMA_SALT2BETA: 0.22  0.22

# Dust model (BS21/P23)
# R_V distribution depends on host mass
# High mass: N(1.66, 0.95), Low mass: N(3.25, 0.93)
GENPEAK_RV:     1.66
GENSIGMA_RV:    0.95  0.95
GENRANGE_RV:    0.5   6.0

# E_dust ~ Exp(tau), tau depends on host mass
GENRANGE_AV:    0.0   3.0
GENTAU_AV:      0.11

# Use host-mass-dependent dust parameters
# (SNANA HOSTLIB handles the mass-dependence internally)

OPT_MWEBV:      1
OPT_MWCOLORLAW: 99
RV_MWCOLORLAW:  3.1

SMEARFLAG_FLUX:    1
SMEARFLAG_ZEROPT:  1

GENSIGMA_VPEC: 250
VPEC_ERR:      250

OMEGA_MATTER: 0.3089
OMEGA_LAMBDA: 0.6911
W0_LAMBDA:   -1.00
H0:           67.74

NGENTOT_LC: 100000

APPLY_CUTWIN_OPT: 1
CUTWIN_SNRMAX:   5 griz 1 -20. 80.
CUTWIN_NEPOCH:   3 -5.
CUTWIN_TRESTMIN:  -15  +10
CUTWIN_TRESTMAX:   +5  +45
CUTWIN_MWEBV:      0   0.25

FORMAT_MASK:  48
PATH_SNDATA_SIM: /Volumes/External24TB/dustai/snana_sims/output

SIMGEN_DUMP: 11
  CID GENTYPE GENZ PEAKMJD SALT2x1 SALT2c SIM_mB SNRMAX AV RV MU

CIDOFF: 0

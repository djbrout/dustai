\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {(a)}~BBC barely changes the Hubble residual distribution: kurtosis is $\sim 3$ with or without BBC. \textbf  {(b)}~Cumulative likelihood contribution sorted by residual size. In the Gaussian (blue), the top 10\% of outlier SNe contribute 66\% of $\chi ^2$. The Student-$t$ (red) reduces this to 59\%, breaking the outlier dominance. \textbf  {(c)}~$f\sigma _8$ bias on real SNANA P23 data (2125 SNe): the Student-$t$ without BBC ($+14\%$) outperforms Gaussian + BBC ($-28\%$). BBC worsens both likelihoods.}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:bbc_vs_studentt}{{7}{7}{\textbf {(a)}~BBC barely changes the Hubble residual distribution: kurtosis is $\sim 3$ with or without BBC. \textbf {(b)}~Cumulative likelihood contribution sorted by residual size. In the Gaussian (blue), the top 10\% of outlier SNe contribute 66\% of $\chi ^2$. The Student-$t$ (red) reduces this to 59\%, breaking the outlier dominance. \textbf {(c)}~$f\sigma _8$ bias on real SNANA P23 data (2125 SNe): the Student-$t$ without BBC ($+14\%$) outperforms Gaussian + BBC ($-28\%$). BBC worsens both likelihoods}{figure.7}{}}

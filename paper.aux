\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Residual $+8\%$ bias on Uchuu}{4}{subsection.5.2}\protected@file@percent }
\newlabel{sec:residual_bias}{{5.2}{4}{}{subsection.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The complete causal chain from P23 dust to $f\sigma _8$ bias. \textbf  {Step 1:} P23 color = Gaussian + Exponential. \textbf  {Step 2:} Single Tripp $\beta $ cannot fit two components. \textbf  {Step 3:} Residuals become skewed and heavy-tailed. \textbf  {Step 4:} $M_0$ absorbs the mean; skewness is harmless. \textbf  {Step 5:} $\chi ^2$ squares residuals, so only kurtosis biases $f\sigma _8$. \textbf  {Step 6:} Student-$t$ down-weights outliers. \textbf  {Step 7:} BBC fixes the mean (already OK), not the shape. Bottom middle: bias on real SNANA P23 data.}}{5}{figure.6}\protected@file@percent }
\newlabel{fig:full_story}{{6}{5}{The complete causal chain from P23 dust to $f\sigma _8$ bias. \textbf {Step 1:} P23 color = Gaussian + Exponential. \textbf {Step 2:} Single Tripp $\beta $ cannot fit two components. \textbf {Step 3:} Residuals become skewed and heavy-tailed. \textbf {Step 4:} $M_0$ absorbs the mean; skewness is harmless. \textbf {Step 5:} $\chi ^2$ squares residuals, so only kurtosis biases $f\sigma _8$. \textbf {Step 6:} Student-$t$ down-weights outliers. \textbf {Step 7:} BBC fixes the mean (already OK), not the shape. Bottom middle: bias on real SNANA P23 data}{figure.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}BBC makes P23 worse, not better}{5}{subsection.5.3}\protected@file@percent }
